# NextStepCV backend - variables de entorno
# Copia este archivo a .env y ajusta los valores según el entorno.

# Servidor (uvicorn)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Tiempo de vida del enlace de descarga (segundos)
PDF_TTL_SECONDS=600

# Si true, el enlace solo sirve una descarga y luego se borra el PDF
DOWNLOAD_ONCE=true

# Frecuencia del barrido de recursos expirados (segundos)
CLEANUP_INTERVAL_SECONDS=300

# Carpeta temporal donde se escriben los PDFs mientras tienen enlace activo
PDF_OUTPUT_DIR=/tmp/cvs

# Tamaño máximo de la foto de perfil en bytes (10 MB por defecto)
MAX_IMAGE_SIZE_BYTES=10485760

# Orígenes permitidos para CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:5173"]